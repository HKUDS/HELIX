{
  "suite": "smoke",
  "timeoutMs": 30000,
  "maxSteps": 3,
  "allowedTools": ["read"],
  "writePaths": [],
  "envAllowlist": ["PATH", "LANG", "LC_ALL", "TZ", "SSL_CERT_FILE", "NODE_EXTRA_CA_CERTS", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "ANTHROPIC_API_KEY", "HELIX_LIVE_MODEL", "ANTHROPIC_MODEL", "HELIX_LIVE_BASE_URL"],
  "provider": {
    "steps": [
      {
        "assistantText": "Reading the workspace README.",
        "toolCalls": [
          {
            "toolName": "read",
            "input": {
              "path": "README.md"
            }
          }
        ]
      },
      {
        "assistantText": "The fixture uses common lego atoms plus OpenCode, Pi, and Nanobot product personality atoms."
      }
    ]
  },
  "expected": {
    "visibleAnswerPatterns": [
      "common\\s+(lego\\s+)?atoms",
      "product(-specific)?\\s+(personality\\s+)?atoms"
    ],
    "toolNames": ["read"]
  }
}
