{
  "id": "pi-mono",
  "strategies": [
    {
      "id": "turn.context-builder",
      "config": {
        "variant": "pi-active-leaf-context"
      }
    },
    {
      "id": "tool.permission",
      "config": {
        "source": "pi-extension-events"
      }
    }
  ],
  "policies": [
