# ==============================================================================
# HELIX Closed-Loop Environment Template
# Copy this file to .env in your root directory or load it before running scripts:
#   cp closed-loop/.env.template .env
# ==============================================================================

# HELIX Provider Configuration
# Connect HELIX agent harnesses to your remote Modal vLLM OpenAI-compatible server
HELIX_LIVE_PROVIDER=openai-compatible
HELIX_LIVE_BASE_URL=https://<your-modal-subdomain>--vllm-openai-serve.modal.run/v1
OPENAI_API_KEY=modal-helix-key

# Model Name
# Phase 1 (BUILD): Use Base Model
HELIX_LIVE_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# Phase 2 (REBUILD): Switch to the LoRA fine-tuned adapter served by vLLM
# HELIX_LIVE_MODEL=helix-qwen-lora-adapter

# Modal.com Credentials (Required for running 01_modal_vllm.py and 04_train_lora.py)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# HuggingFace Token (Optional: for downloading gated weights or pushing checkpoints)
HF_TOKEN=

# Evaluation Settings
LCB_SUBSET_SIZE=50
MAX_AGENT_STEPS=10

