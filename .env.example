# Helix live provider parity configuration.
# Copy this file to .env or export the variables in your shell before running:
#   npm run live:provider
#   npm run live:provider:verify

# Required for npm run live:provider.
# Supported values: openai-compatible, openrouter, anthropic, google
HELIX_LIVE_PROVIDER=openrouter
HELIX_LIVE_MODEL=openai/gpt-4.1

# Optional provider endpoint and metadata.
# For custom OpenAI-compatible endpoints, set HELIX_LIVE_BASE_URL.
HELIX_LIVE_BASE_URL=

# Optional OpenRouter attribution metadata.
HELIX_LIVE_APP_URL=
HELIX_LIVE_APP_NAME=Helix

# Provider credentials. Fill only the key for the provider you use.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Provider-specific model fallbacks.
# HELIX_LIVE_MODEL takes precedence when set.
OPENROUTER_MODEL=
ANTHROPIC_MODEL=
OPENAI_MODEL=
GOOGLE_MODEL=
GEMINI_MODEL=

# Optional credentials for OpenCode built-in provider surfaces.
# These are not required for the Helix live provider parity flow unless
# you explicitly exercise the corresponding upstream/provider integration.
CODEX_API_KEY=
POE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
XAI_API_KEY=
